# =========================================================
# Skill Synth AI — Environment Variables
# =========================================================

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=SkillSynthAI_Secure_Key_2024

# --- AI Provider (Gemini) ---
GEMINI_API_KEY=#own api key
GEMINI_MODEL=gemini-flash-latest

# --- GitHub API Token (optional but recommended) ---
# Used for fetching repo data without strict rate limits
GITHUB_TOKEN=#own api key
# --- GitHub OAuth (required for "Login with GitHub") ---
GITHUB_CLIENT_ID=#own api key
GITHUB_CLIENT_SECRET=#own api key

# --- Database ---
DATABASE_URL=sqlite:///app.db

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chromadb

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10

# --- Rate Limiting ---
RATELIMIT_ANALYZE=10 per hour
RATELIMIT_DEFAULT=200 per day;60 per hour
